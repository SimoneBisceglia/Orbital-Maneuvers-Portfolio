%General Mission Analysis Tool(GMAT) Script
%Created: 2023-10-21 16:38:45


%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft Spacecraft;
GMAT Spacecraft.DateFormat = UTCGregorian;
GMAT Spacecraft.Epoch = '18 Mar 2000 11:59:28.000';
GMAT Spacecraft.CoordinateSystem = EarthMJ2000Eq;
GMAT Spacecraft.DisplayStateType = Keplerian;
GMAT Spacecraft.SMA = 7191.938817629027;
GMAT Spacecraft.ECC = 2.45497491762229e-08;
GMAT Spacecraft.INC = 0;
GMAT Spacecraft.RAAN = 0;
GMAT Spacecraft.AOP = 0;
GMAT Spacecraft.TA = 0;
GMAT Spacecraft.DryMass = 850;
GMAT Spacecraft.Cd = 2.2;
GMAT Spacecraft.Cr = 1.8;
GMAT Spacecraft.DragArea = 15;
GMAT Spacecraft.SRPArea = 1;
GMAT Spacecraft.SPADDragScaleFactor = 1;
GMAT Spacecraft.SPADSRPScaleFactor = 1;
GMAT Spacecraft.AtmosDensityScaleFactor = 1;
GMAT Spacecraft.ExtendedMassPropertiesModel = 'None';
GMAT Spacecraft.NAIFId = -10000001;
GMAT Spacecraft.NAIFIdReferenceFrame = -9000001;
GMAT Spacecraft.OrbitColor = Red;
GMAT Spacecraft.TargetColor = Teal;
GMAT Spacecraft.OrbitErrorCovariance = [ 1e+70 0 0 0 0 0 ; 0 1e+70 0 0 0 0 ; 0 0 1e+70 0 0 0 ; 0 0 0 1e+70 0 0 ; 0 0 0 0 1e+70 0 ; 0 0 0 0 0 1e+70 ];
GMAT Spacecraft.CdSigma = 1e+70;
GMAT Spacecraft.CrSigma = 1e+70;
GMAT Spacecraft.Id = 'SatId';
GMAT Spacecraft.Attitude = CoordinateSystemFixed;
GMAT Spacecraft.SPADSRPInterpolationMethod = Bilinear;
GMAT Spacecraft.SPADSRPScaleFactorSigma = 1e+70;
GMAT Spacecraft.SPADDragInterpolationMethod = Bilinear;
GMAT Spacecraft.SPADDragScaleFactorSigma = 1e+70;
GMAT Spacecraft.AtmosDensityScaleFactorSigma = 1e+70;
GMAT Spacecraft.ModelFile = 'aura.3ds';
GMAT Spacecraft.ModelOffsetX = 0;
GMAT Spacecraft.ModelOffsetY = 0;
GMAT Spacecraft.ModelOffsetZ = 0;
GMAT Spacecraft.ModelRotationX = 0;
GMAT Spacecraft.ModelRotationY = 0;
GMAT Spacecraft.ModelRotationZ = 0;
GMAT Spacecraft.ModelScale = 1;
GMAT Spacecraft.AttitudeDisplayStateType = 'Quaternion';
GMAT Spacecraft.AttitudeRateDisplayStateType = 'AngularVelocity';
GMAT Spacecraft.AttitudeCoordinateSystem = EarthMJ2000Eq;
GMAT Spacecraft.EulerAngleSequence = '321';




%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel DefaultProp_ForceModel;
GMAT DefaultProp_ForceModel.CentralBody = Earth;
GMAT DefaultProp_ForceModel.PrimaryBodies = {Earth};
GMAT DefaultProp_ForceModel.Drag = None;
GMAT DefaultProp_ForceModel.SRP = Off;
GMAT DefaultProp_ForceModel.RelativisticCorrection = Off;
GMAT DefaultProp_ForceModel.ErrorControl = RSSStep;
GMAT DefaultProp_ForceModel.GravityField.Earth.Degree = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.Order = 4;
GMAT DefaultProp_ForceModel.GravityField.Earth.StmLimit = 100;
GMAT DefaultProp_ForceModel.GravityField.Earth.PotentialFile = 'JGM2.cof';
GMAT DefaultProp_ForceModel.GravityField.Earth.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator DefaultProp;
GMAT DefaultProp.FM = DefaultProp_ForceModel;
GMAT DefaultProp.Type = RungeKutta89;
GMAT DefaultProp.InitialStepSize = 60;
GMAT DefaultProp.Accuracy = 9.999999999999999e-12;
GMAT DefaultProp.MinStep = 0.001;
GMAT DefaultProp.MaxStep = 2700;
GMAT DefaultProp.MaxStepAttempts = 50;
GMAT DefaultProp.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Burns
%----------------------------------------

Create ImpulsiveBurn FirstTransferTrajectory;
GMAT FirstTransferTrajectory.CoordinateSystem = Local;
GMAT FirstTransferTrajectory.Origin = Earth;
GMAT FirstTransferTrajectory.Axes = VNB;
GMAT FirstTransferTrajectory.Element1 = 0;
GMAT FirstTransferTrajectory.Element2 = 0;
GMAT FirstTransferTrajectory.Element3 = 0;
GMAT FirstTransferTrajectory.DecrementMass = false;
GMAT FirstTransferTrajectory.Isp = 300;
GMAT FirstTransferTrajectory.GravitationalAccel = 9.81;

Create ImpulsiveBurn SecondTransferTrajectory;
GMAT SecondTransferTrajectory.CoordinateSystem = Local;
GMAT SecondTransferTrajectory.Origin = Earth;
GMAT SecondTransferTrajectory.Axes = VNB;
GMAT SecondTransferTrajectory.Element1 = 0;
GMAT SecondTransferTrajectory.Element2 = 0;
GMAT SecondTransferTrajectory.Element3 = 0;
GMAT SecondTransferTrajectory.DecrementMass = false;
GMAT SecondTransferTrajectory.Isp = 300;
GMAT SecondTransferTrajectory.GravitationalAccel = 9.81;

Create ImpulsiveBurn FinalOrbit;
GMAT FinalOrbit.CoordinateSystem = Local;
GMAT FinalOrbit.Origin = Earth;
GMAT FinalOrbit.Axes = VNB;
GMAT FinalOrbit.Element1 = 0;
GMAT FinalOrbit.Element2 = 0;
GMAT FinalOrbit.Element3 = 0;
GMAT FinalOrbit.DecrementMass = false;
GMAT FinalOrbit.Isp = 300;
GMAT FinalOrbit.GravitationalAccel = 9.81;

%----------------------------------------
%---------- Solvers
%----------------------------------------

Create DifferentialCorrector DC1;
GMAT DC1.ShowProgress = true;
GMAT DC1.ReportStyle = Normal;
GMAT DC1.ReportFile = 'DifferentialCorrectorDefaultDC.data';
GMAT DC1.MaximumIterations = 25;
GMAT DC1.DerivativeMethod = ForwardDifference;
GMAT DC1.Algorithm = NewtonRaphson;

%----------------------------------------
%---------- Subscribers
%----------------------------------------

Create OrbitView DefaultOrbitView;
GMAT DefaultOrbitView.SolverIterations = Current;
GMAT DefaultOrbitView.UpperLeft = [ 0 0 ];
GMAT DefaultOrbitView.Size = [ 0.9992753623188406 0.9984848484848485 ];
GMAT DefaultOrbitView.RelativeZOrder = 81;
GMAT DefaultOrbitView.Maximized = false;
GMAT DefaultOrbitView.Add = {Spacecraft, Earth};
GMAT DefaultOrbitView.CoordinateSystem = EarthMJ2000Eq;
GMAT DefaultOrbitView.DrawObject = [ true true ];
GMAT DefaultOrbitView.DataCollectFrequency = 1;
GMAT DefaultOrbitView.UpdatePlotFrequency = 50;
GMAT DefaultOrbitView.NumPointsToRedraw = 0;
GMAT DefaultOrbitView.ShowPlot = true;
GMAT DefaultOrbitView.MaxPlotPoints = 20000;
GMAT DefaultOrbitView.ShowLabels = true;
GMAT DefaultOrbitView.ViewPointReference = Earth;
GMAT DefaultOrbitView.ViewPointVector = [ 0 90000 0 ];
GMAT DefaultOrbitView.ViewDirection = Earth;
GMAT DefaultOrbitView.ViewScaleFactor = 1;
GMAT DefaultOrbitView.ViewUpCoordinateSystem = EarthMJ2000Eq;
GMAT DefaultOrbitView.ViewUpAxis = Z;
GMAT DefaultOrbitView.EclipticPlane = Off;
GMAT DefaultOrbitView.XYPlane = On;
GMAT DefaultOrbitView.WireFrame = Off;
GMAT DefaultOrbitView.Axes = On;
GMAT DefaultOrbitView.Grid = Off;
GMAT DefaultOrbitView.SunLine = Off;
GMAT DefaultOrbitView.UseInitialView = On;
GMAT DefaultOrbitView.StarCount = 7000;
GMAT DefaultOrbitView.EnableStars = On;
GMAT DefaultOrbitView.EnableConstellations = On;

Create XYPlot XYPlot1;
GMAT XYPlot1.SolverIterations = Current;
GMAT XYPlot1.UpperLeft = [ 0.3623188405797101 0.01212121212121212 ];
GMAT XYPlot1.Size = [ 0.4101449275362319 0.3772727272727273 ];
GMAT XYPlot1.RelativeZOrder = 95;
GMAT XYPlot1.Maximized = false;
GMAT XYPlot1.XVariable = Spacecraft.A1ModJulian;
GMAT XYPlot1.YVariables = {Spacecraft.Earth.RMAG};
GMAT XYPlot1.ShowGrid = true;
GMAT XYPlot1.ShowPlot = true;

Create XYPlot XYPlot2;
GMAT XYPlot2.SolverIterations = Current;
GMAT XYPlot2.UpperLeft = [ 0.003623188405797101 0 ];
GMAT XYPlot2.Size = [ 0.5 0.45 ];
GMAT XYPlot2.RelativeZOrder = 93;
GMAT XYPlot2.Maximized = false;
GMAT XYPlot2.XVariable = Spacecraft.A1ModJulian;
GMAT XYPlot2.YVariables = {Spacecraft.Earth.ECC};
GMAT XYPlot2.ShowGrid = true;
GMAT XYPlot2.ShowPlot = true;

Create GroundTrackPlot GroundTrackPlot1;
GMAT GroundTrackPlot1.SolverIterations = Current;
GMAT GroundTrackPlot1.UpperLeft = [ 0.003623188405797101 0.4560606060606061 ];
GMAT GroundTrackPlot1.Size = [ 0.5 0.45 ];
GMAT GroundTrackPlot1.RelativeZOrder = 87;
GMAT GroundTrackPlot1.Maximized = false;
GMAT GroundTrackPlot1.Add = {Spacecraft};
GMAT GroundTrackPlot1.DataCollectFrequency = 1;
GMAT GroundTrackPlot1.UpdatePlotFrequency = 50;
GMAT GroundTrackPlot1.NumPointsToRedraw = 0;
GMAT GroundTrackPlot1.ShowPlot = true;
GMAT GroundTrackPlot1.MaxPlotPoints = 20000;
GMAT GroundTrackPlot1.CentralBody = Earth;
GMAT GroundTrackPlot1.TextureMap = 'ModifiedBlueMarble.jpg';


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Propagate 'Parking Orbit' DefaultProp(Spacecraft) {Spacecraft.ElapsedDays = 1, OrbitColor = [255 0 0]};
Propagate 'GoToPeriapsis' DefaultProp(Spacecraft) {Spacecraft.Earth.Periapsis, OrbitColor = [255 0 0]};
Target DC1 {SolveMode = Solve, ExitMode = DiscardAndContinue, ShowProgressWindow = true};
   Vary 'Delta_V1' DC1(FirstTransferTrajectory.Element1 = 0, {Perturbation = 0.0001, Lower = 0.0, Upper = 3, MaxStep = 0.2, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'TransferEllipse1' FirstTransferTrajectory(Spacecraft);
   Propagate 'GoToApoapsis' DefaultProp(Spacecraft) {Spacecraft.Earth.Apoapsis, OrbitColor = [255 255 255]};
   Achieve 'AchieveRMAG1' DC1(Spacecraft.Earth.RMAG = 60000, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Target DC1 {SolveMode = Solve, ExitMode = DiscardAndContinue, ShowProgressWindow = true};
   Vary 'Delta_V2' DC1(SecondTransferTrajectory.Element1 = 0, {Perturbation = 0.0001, Lower = 0.0, Upper = 3, MaxStep = 0.2, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'TransferEllipse2' SecondTransferTrajectory(Spacecraft);
   Propagate 'GoToPeriapsis' DefaultProp(Spacecraft) {Spacecraft.Earth.Periapsis, OrbitColor = [0 255 0]};
   Achieve 'AchieveRMAG2' DC1(Spacecraft.Earth.RMAG = 42165.0, {Tolerance = 0.1});
EndTarget;  % For targeter DefaultDC
Target DC1 {SolveMode = Solve, ExitMode = DiscardAndContinue, ShowProgressWindow = true};
   Vary 'Delta_V3' DC1(FinalOrbit.Element1 = 0, {Perturbation = 0.0001, Lower = 0.0, Upper = 3, MaxStep = 0.2, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'FinalOrbit' BackProp FinalOrbit(Spacecraft);
   Achieve 'AchieveECC' DC1(Spacecraft.Earth.ECC = 0.0, {Tolerance = 0.001});
EndTarget;  % For targeter DefaultDC
Propagate 'Final Orbit' DefaultProp(Spacecraft) {Spacecraft.ElapsedDays = 2, OrbitColor = [0 0 254]};
